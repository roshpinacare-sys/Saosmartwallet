// SOVEREIGN GATE — operator key-vault + agent gateway schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton config row (id = "gate"): master key sealed with scrypt(passphrase)
model GateConfig {
  id          String   @id // "gate"
  initialized Boolean  @default(false)
  kdfSalt     String? // hex — scrypt salt for passphrase
  encMaster   String? // hex — AES-256-GCM(masterKey, key=scrypt(passphrase))
  sealIv      String? // hex
  sealTag     String? // hex
  hint        String?
  keySeals    String? // JSON — [{pub,kdfSalt,encMaster,sealIv,sealTag,addedAt}]: the SAME master sealed under each proven control-key (open the vault with ANY current key — passphrase is never a single point of failure again)
  createdAt   DateTime @default(now())
  unlockedAt  DateTime?
}

// Every secret/key lives here ENCRYPTED. priv bytes never leave server unencrypted.
model VaultEntry {
  id         String    @id @default(cuid())
  kind       String // steem-key | evm-key | tron-key | sol-key | mnemonic | token | note
  chain      String? // steem | hive | ethereum | tron | solana | github | infra
  account    String? // headcorner, cashmachine, ...
  role       String? // owner | active | posting | memo | wallet | infrastructure
  pub        String? // derived public key / address (not secret)
  encPriv    String // hex — AES-256-GCM(private material, masterKey)
  privIv     String // hex
  privTag    String // hex
  status     String // verified | rotated-out | unverifiable | imported
  verifyNote String?
  source     String? // upload-file | agent-env | vault-json | operator-input | registry
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([chain, account, role, pub])
}

// Persistent login sessions ("תישאר מחובר") — cookie token stored hashed
model GateSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // sha256 hex of cookie token
  kind       String // operator | account
  name       String // "operator" | account name
  scopes     String // JSON array of account@chain scopes
  encMaster  String? // JSON {ct,iv,tag} — the master key sealed under scrypt(token, sealSalt): lets the session itself re-open the vault (view keys) even after a server restart, without ever storing the token
  sealSalt   String? // hex — per-session salt for the token-derived KEK
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)
}

// Attached agents ("סוכנים כמוך") — API tokens
model GateAgent {
  id         String    @id @default(cuid())
  name       String    @unique
  tokenHash  String    @unique // sha256 of bearer token (token shown once at creation)
  memo       String?
  modules    String? // JSON array of harness-module ids the agent is armed with (skills/connectors)
  brain      String? // brain spec "provider:model" — nvidia:openai/gpt-oss-20b | zai:default
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
}

// Harness runs — external state: the loop's memory lives HERE (system of record),
// never only inside a model's context window. Goal + done-means + full evidence trace.
model GateRun {
  id         String    @id @default(cuid())
  agentName  String
  goal       String
  doneMeans  String // JSON array — done-criteria contract (what "done" concretely means)
  modules    String // JSON array of module ids armed for this run
  brain      String // maker brain spec "provider:model"
  checker    String   // checker brain spec — ALWAYS a different brain than maker (generator/evaluator separation)
  budget     Int // max maker steps (token-blowout guard)
  status     String // queued | running | done | blocked | failed
  verdict    String? // JSON — independent checker verdict {done, checks[], gaps, notes}
  steps      String? // JSON array — append-only evidence trace [{i,thought,tool,args,ok,result,at}]
  report     String? // final Hebrew report written to the command bridge
  error      String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([createdAt])
}

// The shared chat feed — operator + agents write here
model GateMessage {
  id        String   @id @default(cuid())
  channel   String   @default("command") // command | audit
  fromKind  String // operator | agent | system
  fromName  String
  body      String
  meta      String? // JSON
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Audit of every executed action
model GateAction {
  id        String   @id @default(cuid())
  agentName String
  action    String
  params    String? // JSON
  ok        Boolean
  result    String? // JSON / text
  createdAt DateTime @default(now())

  @@index([createdAt])
}
