// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Sovereign Key Vault (M2 — packages/core persistence)
// ---------------------------------------------------------------------------

/// Singleton row ("vault") holding the full non-secret vault state document:
/// hierarchy metadata, policy rule sets, EncryptedKey envelopes (ciphertext +
/// iv + tag — safe at rest; plaintext keys exist only in volatile memory while
/// unlocked). The master-password verifier is an Argon2id parameter hash.
model VaultState {
  id          String   @id @default("vault")
  version     Int      @default(1)
  stateJson   String
  genesisHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Tamper-evident audit chain. eventHash = SHA-256(previousEventHash ‖ canonical
/// event). seq is a dense sequence assigned by the audit engine. timestamp is
/// epoch MILLISECONDS — BigInt, because Int32 overflows in 1970+68 years.
model AuditEvent {
  id                String  @id @default(cuid())
  seq               Int     @unique
  timestamp         BigInt
  type              String
  actorJson         String
  targetJson        String
  result            String
  reason            String?
  previousEventHash String
  eventHash         String
}

// ---------------------------------------------------------------------------
// Model 1 — Metered Identity Verification API (Week 1 of docs/what-we-can-do-now.md)
// ---------------------------------------------------------------------------

/// Developer API key for the metered product endpoint (POST /api/v1/identity/verify).
/// The raw key (`saos_live_` + 32 random bytes, base64url) is shown EXACTLY ONCE
/// at creation; only its SHA-256 hash is ever stored. `prefix` keeps the first 16
/// characters so the console can display and the product endpoint can label the
/// caller without revealing the secret.
model ApiKey {
  id         String        @id @default(cuid())
  name       String
  prefix     String        @unique
  keyHash    String        @unique
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  lastUsedAt DateTime?
  records    UsageRecord[]
}

/// One row per executed product call — the usage ledger. outcome is
/// PROVEN | FAILED | ERROR (the service did real chain work in every case,
/// so every executed call consumes quota — stated honestly in the console).
model UsageRecord {
  id        String   @id @default(cuid())
  keyId     String
  key       ApiKey   @relation(fields: [keyId], references: [id], onDelete: Cascade)
  endpoint  String
  outcome   String
  username  String?
  latencyMs Int
  createdAt DateTime @default(now())

  @@index([keyId, createdAt])
  @@index([createdAt])
}

/// Atomic per-key daily quota reservation counter (one row per key per UTC
/// day). The gate is a single conditional INSERT..ON CONFLICT..DO UPDATE
/// (used < limit) — check-then-act on the ledger admitted exactly one
/// in-flight call over the limit under concurrency (measured live in
/// docs/m1-429-liveburn.md); the reservation closes that off-by-one. The
/// ledger stays the truth of EXECUTED calls; at completion of all reserved
/// calls the two converge (a crash between reserve and meter errs
/// conservative: quota consumed without a ledger row).
model QuotaCounter {
  id        String   @id @default(cuid())
  keyId     String
  dayUtc    String
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([keyId, dayUtc])
  @@index([dayUtc])
}

/// Owner gate for key-management routes (create/revoke keys) — closes the
/// auth gap declared at Model 1 Week 1. The admin token is shown ONCE at
/// bootstrap (same copy-once discipline as API keys); only its SHA-256 is
/// stored. When env SAOS_ADMIN_TOKEN is set it takes precedence (ops
/// override); the DB credential is the sandbox default path.
model AdminCredential {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  label     String
  createdAt DateTime @default(now())
}