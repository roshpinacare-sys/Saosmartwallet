// SOVEREIGN GATE — operator key-vault + agent gateway schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton config row (id = "gate"): master key sealed with scrypt(passphrase)
model GateConfig {
  id               String   @id // "gate"
  autonomyEnabled  Boolean  @default(true) // the autonomy kill-switch — the Gate Heart checks it FIRST on every beat
  initialized      Boolean  @default(false)
  kdfSalt     String? // hex — scrypt salt for passphrase
  encMaster   String? // hex — AES-256-GCM(masterKey, key=scrypt(passphrase))
  sealIv      String? // hex
  sealTag     String? // hex
  hint        String?
  keySeals    String? // JSON — [{pub,kdfSalt,encMaster,sealIv,sealTag,addedAt}]: the SAME master sealed under each proven control-key (open the vault with ANY current key — passphrase is never a single point of failure again)
  lastRestoreDrill String? // JSON — r37: last restore-drill summary (total/restored/failures/seals/backup) — the standing proof that "restore all keys" actually works
  createdAt   DateTime @default(now())
  unlockedAt  DateTime?
}

// Every secret/key lives here ENCRYPTED. priv bytes never leave server unencrypted.
model VaultEntry {
  id         String    @id @default(cuid())
  kind       String // steem-key | evm-key | tron-key | sol-key | btc-key | mnemonic | token | note
  chain      String? // steem | hive | blurt | ethereum | tron | solana | bitcoin | github | infra | sovereign
  account    String? // headcorner, cashmachine, ..., tron-bridge
  role       String? // owner | active | posting | memo | wallet | bridge-sender | bridge-relay | bridge-squad-2..5 | infrastructure
  pub        String? // derived public key / address (not secret)
  encPriv    String // hex — AES-256-GCM(private material, masterKey)
  privIv     String // hex
  privTag    String // hex
  status     String // verified | rotated-out | unverified | unverifiable | imported | operator-custody
  verifyNote String?
  source     String? // upload-file | agent-env | vault-json | operator-input | registry
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([chain, account, role, pub])
}

// Persistent login sessions ("תישאר מחובר") — cookie token stored hashed
model GateSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // sha256 hex of cookie token
  kind       String // operator | account
  name       String // "operator" | account name
  scopes     String // JSON array of account@chain scopes
  encMaster  String? // JSON {ct,iv,tag} — the master key sealed under scrypt(token, sealSalt): lets the session itself re-open the vault (view keys) even after a server restart, without ever storing the token
  sealSalt   String? // hex — per-session salt for the token-derived KEK
  // ROAST r9 gap-33: sessions minted by a device login used to be orphans —
  // revoking the device left the doors it opened alive for up to 30 days.
  // viaDevice links a session to its origin device so revocation closes them.
  viaDevice  String? // GateDevice.id — set when the session was minted via a trusted-device login
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)
}

// Attached agents ("סוכנים כמוך") — API tokens
model GateAgent {
  id         String    @id @default(cuid())
  name       String    @unique
  tokenHash  String    @unique // sha256 of bearer token (token shown once at creation)
  memo       String?
  modules    String? // JSON array of harness-module ids the agent is armed with (skills/connectors)
  brain      String? // brain spec "provider:model" — nvidia:openai/gpt-oss-20b | zai:default
  active     Boolean   @default(true)
  autonomy   Boolean   @default(true) // may the heart launch this agent on its own (schedules + triggers)?
  // r39 FINANCIAL PERMISSION MODEL (the r28 directive: "הכספת = הבנק של הרשת —
  // הסוכן הראשי מורשה כבר כעת; בעתיד סוכנים מורשים לפעול אוטונומית בכסף"):
  //   none                — this agent cannot even BUILD DEX orders (steem.order.build refuses).
  //   build               — may BUILD orders; the vault signs ONLY on explicit operator decision
  //                         (the r21 doctrine — default for every agent, nothing changed).
  //   autonomous-limited  — the vault signs this agent's pending orders AUTOMATICALLY, but only
  //                         inside finCaps (per-order notional, per-day signed count, per-day
  //                         notional), only limit create/cancel (no convert), only while the
  //                         vault is open — and every policy signature is audited + bridged.
  finTier    String    @default("build")
  finCaps    String? // JSON {maxNotionalPerOrder, maxSignedPerDay, maxNotionalPerDay} — null = FIN_CAPS_DEFAULTS
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
}

// Harness runs — external state: the loop's memory lives HERE (system of record),
// never only inside a model's context window. Goal + done-means + full evidence trace.
model GateRun {
  id         String    @id @default(cuid())
  agentName  String
  goal       String
  doneMeans  String // JSON array — done-criteria contract (what "done" concretely means)
  modules    String // JSON array of module ids armed for this run
  brain      String // maker brain spec "provider:model"
  checker    String   // checker brain spec — ALWAYS a different brain than maker (generator/evaluator separation)
  budget     Int // max maker steps (token-blowout guard)
  status     String // queued | running | done | blocked | failed
  origin     String    @default("manual") // manual | schedule | trigger — WHO wanted this run (autonomy lineage, answered in the pulse panel)
  meta       String? // JSON — {scheduleId?, triggerId?, eventId?, note?} — the why behind an autonomous run
  leaseOwner String? // worker id that claimed this run (crash-safety: the trace IS the checkpoint)
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime? // renewed after every persisted step
  retryNotBefore DateTime? // r36 crash-burst backoff — a re-queued crashed run is not claimable until this passes (the retry lands on a WARM server, not inside a restart storm)
  attempt        Int       @default(0) // incremented on every claim — >1 means this run RECOVERED from a crash
  maxAttempts    Int       @default(2)
  verdict    String? // JSON — independent checker verdict {done, checks[], gaps, notes}
  steps      String? // JSON array — append-only evidence trace [{i,thought,tool,args,ok,result,ms,at}]
  report     String? // final Hebrew report written to the command bridge
  lessons    String? // JSON array — lessons distilled from the agent's PAST runs, injected into the maker's first prompt (cross-run external memory)
  durationMs Int? // total wall-clock of the whole loop — real efficiency, not vibes
  tokens     String? // JSON {prompt, completion} — real brain usage when the provider reports it (null when unknown — never faked)
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  finishedAt DateTime?

  @@index([createdAt])
  @@index([status])
  @@index([agentName, createdAt]) // runs.self — an agent reading its own past must not scan the table
}

// The Gate Heart — schedules: goals the agents run ON THEIR OWN, on cadence.
// (steem-army daemon loops + ECOS automationScheduler pattern: persisted so
// autonomy survives reboots without anyone pressing a button)
model GateSchedule {
  id        String   @id @default(cuid())
  label     String // human-readable patrol name (Hebrew)
  agentName String
  goal      String
  doneMeans String // JSON array
  modules   String? // JSON array — defaults to the agent's armed modules
  brain     String?
  budget    Int      @default(5)
  kind      String   @default("interval") // interval | daily
  everyMs   Int? // interval kind
  hourUtc   Int? // daily kind (0-23)
  maxPerDay Int      @default(8)
  dayCount  Int      @default(0)
  dayKey    String? // "2026-09-09" (UTC) — daily cap reset
  enabled   Boolean  @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime @default(now())
  createdAt DateTime @default(now())
}

// Autonomy events — the nervous system's stimuli (bridge mentions, run verdicts).
// At-least-once: the heart consumes them into trigger fires (workspace outbox pattern).
model GateEvent {
  id        String   @id @default(cuid())
  type      String // message.mentions | run.blocked | run.failed | run.done
  payload   String? // JSON — {agent, body?, goal?, gaps?, by?}
  source    String // operator | agent | harness
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Trigger rules — WHEN an event becomes an autonomous run (cooldown + daily cap = bounded).
model GateTrigger {
  id           String   @id @default(cuid())
  on           String // "message.mentions" | "run.blocked" | "run.failed"
  agentName    String // the agent that acts ("@self" = the agent named in the event payload)
  goalTemplate String // {body} {goal} {gaps} {agent} placeholders
  doneMeans    String // JSON array
  budget       Int      @default(4)
  cooldownMs   Int      @default(300000)
  maxPerDay    Int      @default(3)
  dayCount     Int      @default(0)
  dayKey       String?
  lastFiredAt  DateTime?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Tiny KV — the heart's own pulse record + future watermarks (chain.watch state).
model GateState {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

// Trusted devices ("זכור אותי בצורה בטוחה") — after a live-key login the operator
// can arm THIS browser: a random device token lives ONLY in its localStorage;
// the master key is sealed under scrypt(deviceToken, deviceSalt). The DB alone
// (hash + ciphertext) can neither log in nor open the vault — possession of the
// device IS the second factor. Revocable, 90-day expiry, audited on use.
model GateDevice {
  id         String   @id @default(cuid())
  label      String // human-readable ("Chrome · Android")
  tokenHash  String   @unique // sha256 of the device token — raw token never stored server-side
  // ROAST r9 gap-31: revocation used to keep the sealed master in the DB and
  // rely on a boolean flag — "inert" was one UPDATE away from alive. Now a
  // revoke SCRUBS the ciphertext + salt to null: inert by data, not by flag.
  encMaster  String? // JSON Seal — master key sealed under scrypt(deviceToken, deviceSalt); null after revoke (scrubbed)
  deviceSalt String? // hex — per-device salt for the token-derived KEK; null after revoke (scrubbed)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)
}

// The shared chat feed — operator + agents write here
model GateMessage {
  id        String   @id @default(cuid())
  channel   String   @default("command") // command | audit
  fromKind  String // operator | agent | system
  fromName  String
  body      String
  meta      String? // JSON
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Fleet memory (ביקורת #8 — נפתר) — the shared knowledge bank: FINAL findings
// recorded ONCE under a canonical key; every agent reads BEFORE re-researching,
// so one expensive probe (e.g. an authority-drift verification) teaches the
// whole fleet instead of being paid again run after run.
// Pollution defenses, enforced in code: canonical-key upsert (a fact UPDATES
// itself instead of duplicating), body clamp, total-cap with evict-oldest,
// provenance (source + runId) and a refCount that says which knowledge is used.
model GateMemory {
  id        String   @id @default(cuid())
  key       String   @unique // canonical fact key, e.g. "drift:headcorner"
  kind      String // drift | finding | fact
  body      String // the distilled knowledge itself (Hebrew, clamped)
  source    String // who wrote it — agent name or "harness"
  runId     String? // originating run (provenance, audit trail)
  refCount  Int      @default(0) // how many times agents actually read it
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// Goal initiative (ביקורת #7 — נפתר) — an armed agent PROPOSES a goal with
// doneMeans; the boundary decides: explicit operator approval in the UI, or
// the bounded auto-approve policy (fleet daily cap + budget cap + armed
// agent + idle agent). "הסוכן מציע — הגבול מחליט."
model GateProposal {
  id        String    @id @default(cuid())
  agentName String
  goal      String
  rationale String? // WHY the agent believes this is worth doing
  doneMeans String // JSON array — the pass-gate the proposer binds itself to
  budget    Int       @default(4)
  // r15 — proposal kinds: "run" = one goal-loop (the classic, policy may
  // launch it); "schedule-create" = the agent designed its own RECURRING
  // employment (a patrol). A schedule is structural — the policy engine may
  // NEVER auto-adopt one; only the operator can (the initiative stage skips
  // non-run kinds by design — the same doctrine as budget > maxBudget).
  kind      String    @default("run")
  payload   String? // JSON — structured data for non-run kinds (schedule spec)
  status    String    @default("pending") // pending | launched | adopted | rejected | expired
  decidedBy String? // operator | policy
  runId     String? // the run created on approval (lineage; null for adopted schedules)
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([status, createdAt])
}

// Audit of every executed action
model GateAction {
  id        String   @id @default(cuid())
  agentName String
  action    String
  params    String? // JSON
  ok        Boolean
  result    String? // JSON / text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// SOVEREIGN-HAND (ביקורת #4 — הצעד-הפתוח האחרון) — the controlled signing
// queue: an armed agent BUILDS a real DEX order (unsigned — building needs no
// keys); the vault signs ONLY on an explicit operator decision, rebuilding the
// EXACT order (fixed orderid + orderExpiration — the steem-order determinism
// contract), broadcasting it with the ACTIVE key and recording the real chain
// evidence. "הסוכן מכין — הכספת חותמת, רק באישור המפעיל."
model GateOrder {
  id            String    @id @default(cuid())
  agentName     String
  runId         String? // lineage — which run built this
  op            String    @default("limit_order_create") // limit_order_create | limit_order_cancel
  account       String // the sovereign commander account — resolved from the vault, never from the agent
  spec          String // JSON — the EXACT SteemOrderSpec (fixed orderid/orderExpiration ⇒ deterministic rebuild)
  preview       String // JSON — human-readable preview shown to operator + agent {side, amount, price, total, expiresAt}
  notionalSteem Float // the STEEM leg size — for the fleet amount rail
  status        String    @default("pending") // pending | signed | rejected | expired | failed
  decidedBy     String? // operator
  previewTxId   String? // txId of the preview build (ref-block differs at signing — the ORDER is what's identical)
  broadcastId   String? // the REAL chain tx id after broadcast
  blockNum      Int?
  error         String?
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([status, createdAt])
}

// ── Developer console (ROAST r4: the module claimed "gated with the same
// discipline as the keys themselves" while its DB models DID NOT EXIST — every
// POST was a live 500. These models make the discipline REAL.) ──────────────
model ApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique // SHA-256(key) — plaintext shown once, never stored
  prefix     String // first 16 chars — safe to display
  name       String
  active     Boolean   @default(true) // revoked = soft delete, usage history kept
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  records  UsageRecord[] // executed-call ledger
  counters QuotaCounter[] // atomic daily quota reservation

  @@index([createdAt])
}

model UsageRecord {
  id        String   @id @default(cuid())
  keyId     String
  key       ApiKey   @relation(fields: [keyId], references: [id])
  endpoint  String
  outcome   String // PROVEN | FAILED | ERROR — metering follows real work
  username  String?
  latencyMs Int
  createdAt DateTime @default(now())

  @@index([keyId, createdAt])
  @@index([createdAt])
}

model AdminCredential {
  id        String   @id // FIXED singleton id ("admin-primary") — bootstrap-once
  tokenHash String   @unique // SHA-256 of the admin bearer
  label     String   @default("bootstrap")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuotaCounter {
  id        String   @id // qc_… (client-generated for the atomic upsert)
  keyId     String
  key       ApiKey   @relation(fields: [keyId], references: [id])
  dayUtc    String // "YYYY-MM-DD" — the quota window
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([keyId, dayUtc]) // the INSERT..ON CONFLICT contract in api-keys.ts
}

// ── M2 vault persistence (ROAST r4, continued): vault-stores.ts claimed
// "per the frozen prisma/schema.prisma models" for VaultState and AuditEvent
// while NEITHER model existed in the schema — the vault could never persist
// a byte (STORAGE_FAILURE on every touch). The seam is real now. ────────────
model VaultState {
  id          String   @id // singleton row: "vault"
  stateJson   String // the full sealed VaultState document (keys stay AES-256-GCM envelopes)
  genesisHash String
  updatedAt   DateTime @updatedAt
}

model AuditEvent {
  id                String  @id
  seq               Int     @unique // hash-chain ordering — concurrent append must collide here
  timestamp         BigInt // epoch ms (Int32 overflows)
  type              String
  actorJson         String // JSON — metadata-only by construction
  targetJson        String // JSON — metadata-only by construction
  result            String // success | failure | blocked
  reason            String?
  previousEventHash String
  eventHash         String

  @@index([seq])
  @@index([type])
}
