#!/usr/bin/env bash
# GitGate credential helper — the I/O boundary of the GitGate secret store.
#
# Modeled on devgate's SecretBroker (src/devgate/secrets/broker.py):
#   - the token lives ONLY in ~/.gitgate/secrets/github.token (0600, dir 0700)
#   - this helper is the ONLY component that reads it for git operations
#   - it never logs, never echoes, and never writes the token anywhere else
#
# Registered in global git config as:
#   credential.https://github.com.helper = <path to this file>
# This makes it valid for EVERY repo on this machine (any folder, any chat).
#
# git credential protocol:
#   get    -> emit username/password if a token exists
#   store  -> no-op (rotation happens only via `gitgate set-token`)
#   erase  -> no-op (the store is authoritative, not git's cache)
set -uo pipefail

STORE="${GITGATE_STORE:-$HOME/.gitgate/secrets/github.token}"

case "${1:-}" in
  get)
    [ -r "$STORE" ] || exit 1
    token="$(tr -d '[:space:]' < "$STORE" 2>/dev/null)"
    if [ -z "$token" ]; then
      exit 1
    fi
    printf 'username=x-access-token\n'
    printf 'password=%s\n' "$token"
    ;;
  store|erase)
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
